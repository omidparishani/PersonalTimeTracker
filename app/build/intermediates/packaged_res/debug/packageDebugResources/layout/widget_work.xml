<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/widgetTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ردیاب زمان" android:textColor="#FFFFFF" android:textSize="11sp" android:alpha="0.85"/>
        <TextView android:id="@+id/widgetWorkedToday" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="#FFFFFF" android:textSize="11sp" android:alpha="0.9"/>
    </LinearLayout>

    <TextView android:id="@+id/widgetStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="—" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:paddingTop="4dp"/>
    <TextView android:id="@+id/widgetDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="—" android:textColor="#FFFFFF" android:textSize="12sp" android:paddingTop="2dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp">
        <TextView android:id="@+id/widgetCheckIn"
            android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="ورود"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/widget_btn_bg"/>
        <TextView android:id="@+id/widgetCheckOut"
            android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="خروج"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/widget_btn_bg"/>
    </LinearLayout>
</LinearLayout>
