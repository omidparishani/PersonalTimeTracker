<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg_dark">#121212</color>
    <color name="bg_light">#F7F9FC</color>
    <color name="black">#000000</color>
    <color name="seed">#1565C0</color>
    <color name="seed_container">#D6E3FF</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">ردیاب زمان شخصی</string>
    <string name="nav_attendance">حضور</string>
    <string name="nav_calendar">تقویم</string>
    <string name="nav_dashboard">داشبورد</string>
    <string name="nav_reports">گزارش</string>
    <string name="nav_settings">تنظیمات</string>
    <string name="nav_tasks">تسک‌ها</string>
    <style name="Theme.PersonalTimeTracker" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/seed</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/seed_container</item>
        <item name="colorSecondary">@color/seed</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/seed</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNav</item>
    </style>
    <style name="Widget.App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="elevation">8dp</item>
        <item name="itemIconSize">24dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
</resources>