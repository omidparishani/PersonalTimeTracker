<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PersonalTimeTracker" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/seed</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/seed_container</item>
        <item name="colorSecondary">@color/seed</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/seed</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNav</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.App.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.App.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.App.Large</item>
    </style>

    <style name="Shape.App.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Shape.App.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Shape.App.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/seed</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="elevation">12dp</item>
        <item name="itemIconSize">24dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:background">@color/white</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNav.ActiveIndicator</item>
    </style>

    <style name="Widget.App.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/seed_container</item>
    </style>

    <style name="BottomNavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>

